TITLE            ?
REVISION         ?
PATTERN          ?
AUTHOR           ?
COMPANY          ?
DATE           08/01/2015

; S0 - S7 Decoded high order 3 bits of address these are input from
;        a 74LS138 so they are active low inputs
;
; P5, P13 and P21 decoded BSC value to select memory block
; RAL when RAL is low CPU is addressing a register (inverted from CPU)
; A12, A13, A14 and A15 High order address bits for EPROM latched
; SEL latched indicator that one of our ROM images has been selected
; Segment 9 of the EPROM is no longer selected it was the first BiSnyc ROM
; but I now have the physical ROM

CHIP     ROMSEL          PALCE22V10


  PIN     1       ALE
  PIN     2       S0
  PIN     3       S1
  PIN     4       S2
  PIN     5       S3
  PIN     6       S4
  PIN     7       S5
  PIN     8       S6
  PIN     9       S7
  PIN     10      RAL
  PIN     13      P5
  PIN     14      P13
  PIN     15      P21
  PIN     19      SEL           REGISTERED
  PIN     20      A12           REGISTERED
  PIN     21      A13           REGISTERED
  PIN     22      A14           REGISTERED
  PIN     23      A15           REGISTERED
EQUATIONS

 A12 = (P5*/S2)+(P13*/S6)+(P21*/S0)+(P21*/S2)+(P13*/S2)
 A13 = (P13*/S5)+(P13*/S6)+(P21*/S1)+(P21*/S2)+(P13*/S1)+(P13*/S2)
 A14 = (P13*/S7)+(P21*/S0)+(P21*/S1)+(P21*/S2)
 A15 = (P21*/S3)+(P13*/S1)+(P13*/S2)
 SEL = ((P5*/S1)+(P5*/S2)+(P13*/S1)+(P13*/S2)+(P13*/S5)+(P13*/S6)+(P13*/S7)+(P21*/S0)+(P21*/S1)+(P21*/S2)+(P21*/S3))*RAL


;----------------------------------- Simulation Segment ------------
SIMULATION

 TRACE_ON  S0 S1 S2 S3 S4 S5 S6 S7 P5 P13 P21 ALE RAL A12 A13 A14 A15 SEL

;0
 SETF S0 /S1 S2 S3 S4 S5 S6 S7  /P5 /P13 /P21 RAL  /ALE
 SETF S0 /S1 S2 S3 S4 S5 S6 S7  /P5 /P13 /P21 RAL  ALE
 SETF S0 /S1 S2 S3 S4 S5 S6 S7  /P5 /P13 /P21 RAL  /ALE
 SETF S0 /S1 S2 S3 S4 S5 S6 S7  P5 /P13 /P21 RAL  /ALE
 CHECK /A12 /A13 /A14 /A15 /SEL
